# ===== PRODUCTION ENVIRONMENT CONFIGURATION =====
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to git!

# ===== API Keys for AI Models =====
OPENAI_API_KEY=your_openai_api_key_here
GROK_API_KEY=your_grok_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===== Security Keys (REQUIRED) =====
# Generate random secrets with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_random_jwt_secret_here
SECRET_KEY=your_random_flask_secret_here

# ===== Flask Environment =====
FLASK_ENV=production
FLASK_DEBUG=0

# ===== Database Paths =====
# Optional - defaults to ./integrated_users.db
DATABASE_PATH=./production_integrated_users.db
SMART_RESPONSE_DB=./production_smart_response.db

# ===== Session & Cookie Security =====
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# ===== Logging =====
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ===== AI Budget Control =====
MAX_AI_CALLS_PER_DAY=100
ADMIN_AI_CALLS_PER_DAY=1000
SYSTEM_AI_CALL_CAP=2000

# ===== AI Context Settings =====
# Number of conversation exchanges to include for AI context (default: 5)
AI_CONTEXT_EXCHANGES=5

# ===== Production Settings =====
# Set to true to disable auto-documentation (recommended for production)
DISABLE_AUTO_DOCS=true

# ===== Server Configuration (for Gunicorn) =====
# WORKERS=4
# THREADS=2
# TIMEOUT=120
